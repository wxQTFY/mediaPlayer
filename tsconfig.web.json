{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
     "src/common/**/*",
     "src/main/config/**/*"
  ],
  "compilerOptions": {
    "composite": true,
     "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@common/*": ["src/common/*"],
    }
  }
}
